# Local synthetic preview only. This is the development container credential.
DNE_DATABASE_URL=postgresql://dne:local-preview-only@127.0.0.1:54329/dne_dev
DNE_PORT=3000
DNE_APP_MODE=demo
DNE_PRIVATE_STORAGE_ROOT=.dne-private/evidence
DNE_DEMO_IMPERSONATION=false

# Opt-in invented event registration; no real appointments or external providers.
DNE_EVENT_REGISTRATION=disabled

# Pause reviewer discovery without changing direct feedback access or grants.
DNE_REVIEWER_WORKLIST_READS=enabled

# Local browser entry for already provisioned staff; no roles or grants created.
DNE_LOCAL_STAFF_ENTRY=disabled
DNE_LOCAL_SUPPORT_ASSIGNMENT=disabled

# Opt-in finite exact-circle grants for existing local staff; no provisioning.
DNE_LOCAL_CIRCLE_ADMIN=disabled
DNE_LOCAL_EVENT_ADMIN=disabled
# New scheduling is opt-in; pausing it retains saved rehearsal readers.
DNE_LOCAL_EVENT_SCHEDULING=disabled
# New private workflow review requests are opt-in; pause preserves withdrawal/recovery.
DNE_WORKFLOW_REVIEW_REQUESTS=disabled
