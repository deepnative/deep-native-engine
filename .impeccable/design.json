  "components": [
    {
      "name": "Primary action",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Implemented action style; visual specimen only.",
      "html": "<button class=\"ds-button-primary\">Continue learning <svg viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14m-6-6 6 6-6 6\"/></svg></button>",
      "css": ".ds-button-primary{display:inline-flex;align-items:center;justify-content:center;gap:9px;border-radius:10px;min-height:46px;padding:11px 18px;border:1px solid transparent;font-family:Inter,sans-serif;font-size:14px;font-weight:680;line-height:1.5;background:var(--blue, #2459d6);color:var(--surface, #ffffff);cursor:pointer;transition:background-color .16s,transform .16s;}.ds-button-primary:hover{background:var(--blue-hover, #1845b0);}.ds-button-primary:focus-visible{outline:3px solid var(--focus, #174dbb);outline-offset:4px;}.ds-button-primary:active{transform:translateY(1px);}.ds-button-primary:disabled{opacity:.5;cursor:default;}@media(prefers-reduced-motion:reduce){.ds-button-primary{transition:none;}.ds-button-primary:active{transform:none;}}"
    },
    {
      "name": "Secondary action",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Implemented action style; visual specimen only.",
      "html": "<button class=\"ds-button-secondary\">Download my work <svg viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14m-6-6 6 6-6 6\"/></svg></button>",
      "css": ".ds-button-secondary{display:inline-flex;align-items:center;justify-content:center;gap:9px;border-radius:10px;min-height:46px;padding:11px 18px;border:1px solid var(--line-strong, #afbed1);font-family:Inter,sans-serif;font-size:14px;font-weight:680;line-height:1.5;background:var(--surface, #ffffff);color:var(--blue, #2459d6);cursor:pointer;transition:background-color .16s,transform .16s;}.ds-button-secondary:hover{background:var(--blue-soft, #eaf0ff);border-color:var(--blue, #2459d6);}.ds-button-secondary:focus-visible{outline:3px solid var(--focus, #174dbb);outline-offset:4px;}.ds-button-secondary:active{transform:translateY(1px);}.ds-button-secondary:disabled{opacity:.5;cursor:default;}@media(prefers-reduced-motion:reduce){.ds-button-secondary{transition:none;}.ds-button-secondary:active{transform:none;}}"
    },
    {
      "name": "Writing field",
      "kind": "input",
      "refersTo": "writing-field",
      "description": "Visible label and resizable private-practice writing field.",
      "html": "<label class=\"ds-writing-label\" for=\"ds-work\">Your lesson work</label><textarea class=\"ds-writing-field\" id=\"ds-work\" rows=\"6\" placeholder=\"Use the invented source. Write what you can explain.\"></textarea>",
      "css": ".ds-writing-label{display:block;font-family:Inter,sans-serif;font-size:16px;font-weight:680;color:var(--ink, #172c46);margin:0 0 10px;}.ds-writing-field{display:block;width:100%;resize:vertical;min-height:150px;border:1px solid var(--line-strong, #afbed1);border-radius:10px;padding:16px;background:var(--surface, #ffffff);color:var(--ink, #172c46);font-family:Inter,sans-serif;font-size:16px;line-height:1.7;caret-color:var(--blue, #2459d6);}.ds-writing-field::placeholder{color:var(--muted, #51647c);opacity:1;}.ds-writing-field:focus-visible{outline:3px solid var(--focus, #174dbb);outline-offset:4px;}"
    },
    {
      "name": "Named navigation",
      "kind": "nav",
      "refersTo": "main-navigation",
      "description": "Current-page treatment from the reader rail.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Reader navigation\"><button aria-current=\"page\"><svg viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 4.5h6a3 3 0 0 1 3 3v13a3 3 0 0 0-3-3H4z\"/><path d=\"M20 4.5h-4a3 3 0 0 0-3 3v13a3 3 0 0 1 3-3h4z\"/></svg>Learn</button><button>Practice</button><button>My work</button></nav>",
      "css": ".ds-nav{display:grid;gap:6px;}.ds-nav button{display:flex;align-items:center;gap:12px;min-height:48px;padding:12px 14px;color:var(--muted, #51647c);background:transparent;border:0;border-radius:10px;text-align:left;font-family:Inter,sans-serif;font-weight:650;font-size:15px;line-height:1.6;cursor:pointer;}.ds-nav button:hover{background:var(--surface-subtle, #edf2f8);color:var(--ink, #172c46);}.ds-nav button[aria-current=\"page\"]{background:var(--blue-soft, #eaf0ff);color:var(--blue, #2459d6);}.ds-nav button:focus-visible{outline:3px solid var(--focus, #174dbb);outline-offset:4px;}"
    },
    {
      "name": "Example route",
      "kind": "chip",
      "refersTo": "route-option",
      "description": "An example-context selector with an explicit selected state.",
      "html": "<div class=\"ds-routes\" role=\"group\" aria-label=\"Choose your example route\"><span>Your examples</span><button aria-pressed=\"true\">Everyday</button><button aria-pressed=\"false\">Work</button><button aria-pressed=\"false\">Technical</button></div>",
      "css": ".ds-routes{display:flex;flex-wrap:wrap;align-items:center;gap:6px;font-family:Inter,sans-serif;}.ds-routes>span{color:var(--muted, #51647c);font-size:13px;margin-right:10px;}.ds-routes button{min-height:44px;border:1px solid var(--line, #d9e2ee);color:var(--muted, #51647c);border-radius:9px;padding:8px 16px;background:var(--surface, #ffffff);font-family:Inter,sans-serif;font-size:13px;font-weight:650;line-height:1.6;cursor:pointer;transition:background-color .16s,border-color .16s;}.ds-routes button:hover{border-color:var(--blue, #2459d6);color:var(--blue, #2459d6);}.ds-routes button[aria-pressed=\"true\"]{background:var(--blue-soft, #eaf0ff);color:var(--blue, #2459d6);border-color:var(--blue, #2459d6);}.ds-routes button:focus-visible{outline:3px solid var(--focus, #174dbb);outline-offset:4px;}@media(prefers-reduced-motion:reduce){.ds-routes button{transition:none;}}"
    },
    {
      "name": "Notebook status",
      "kind": "chip",
      "refersTo": "notebook-status",
      "description": "Passive status paired with the storage location, not an autosave indicator.",
      "html": "<div class=\"ds-notebook-status\"><span>Unsaved changes</span><small>Only in this browser</small></div>",
      "css": ".ds-notebook-status{display:flex;flex-direction:column;align-items:flex-start;gap:2px;font-family:Inter,sans-serif;}.ds-notebook-status>span{display:inline-flex;align-items:center;gap:7px;font-size:12px;font-weight:550;line-height:1.6;padding:5px 10px;border-radius:6px;background:var(--surface-subtle, #edf2f8);color:var(--muted, #51647c);}.ds-notebook-status small{font-size:12px;line-height:1.6;color:var(--muted, #51647c);}"
    },
    {
      "name": "Source context",
      "kind": "card",
      "refersTo": "source-card",
      "description": "A source and a reminder to keep unknown details open.",
      "html": "<aside class=\"ds-source\"><p class=\"ds-source-label\">Your source · Everyday</p><p>Twelve volunteers are available for two hours on Saturday. The venue and budget are undecided.</p><p class=\"ds-source-note\">Compare each claim with these notes. Keep unknown details open.</p></aside>",
      "css": ".ds-source{padding:20px;border:1px solid #bddce2;border-radius:var(--radius,14px);background:var(--teal-soft, #eaf5f7);color:var(--ink, #172c46);font-family:Inter,sans-serif;}.ds-source p{font-size:14px;line-height:1.7;margin:0 0 18px;}.ds-source .ds-source-label{color:var(--teal, #146576);font-size:13px;font-weight:700;margin:0 0 14px;}.ds-source .ds-source-note{padding-top:14px;margin:14px 0 0;border-top:1px solid #bddce2;color:var(--teal, #146576);font-size:13px;}"
    },
    {
      "name": "Checked feedback",
      "kind": "custom",
      "refersTo": "answer-feedback",
      "description": "Checked response states retain words explaining the result.",
      "html": "<div class=\"ds-feedback\"><strong>Try another choice after comparing with the source.</strong><p>You chose B.</p></div><div class=\"ds-feedback ds-feedback-positive\"><strong>This response matches the source.</strong><p>You chose A.</p></div>",
      "css": ".ds-feedback{background:var(--amber-soft, #fff4e3);color:var(--ink, #172c46);border:1px solid #dfbf8c;border-radius:12px;padding:20px;margin-top:20px;font-family:Inter,sans-serif;font-size:15px;line-height:1.7;}.ds-feedback>strong{font-weight:680;color:var(--amber, #875619);}.ds-feedback-positive{border-color:#a5d5bd;background:var(--green-soft, #e9f5ef);}.ds-feedback-positive>strong{color:var(--green, #18715c);}.ds-feedback p{margin:12px 0 0;}"
    },
    {
      "name": "Answer choice",
      "kind": "input",
      "refersTo": "answer-choice",
      "description": "Native radio choices: selection is blue before evaluation.",
      "html": "<fieldset class=\"ds-choice-group\"><legend>Choose a useful task.</legend><label class=\"ds-choice\"><input type=\"radio\" name=\"ds-choice\" checked><span>Draft an activity plan using the available volunteers and time.</span></label><label class=\"ds-choice\"><input type=\"radio\" name=\"ds-choice\"><span>Assume the venue and budget are already agreed.</span></label></fieldset>",
      "css": ".ds-choice-group{margin:0;padding:0;border:0;min-width:0;font-family:Inter,sans-serif;color:var(--ink, #172c46);}.ds-choice-group legend{font-size:18px;line-height:1.5;font-weight:650;margin-bottom:18px;}.ds-choice{display:flex;align-items:flex-start;gap:12px;padding:16px 18px;margin:10px 0;border:1px solid var(--line-strong, #afbed1);border-radius:12px;background:var(--surface, #ffffff);cursor:pointer;transition:background-color .16s,border-color .16s;}.ds-choice:hover,.ds-choice:has(input:checked){background:var(--blue-soft, #eaf0ff);border-color:var(--blue, #2459d6);}.ds-choice input{width:18px;height:18px;flex-shrink:0;margin:4px 0 0;accent-color:var(--blue, #2459d6);}.ds-choice input:focus-visible{outline:3px solid var(--focus, #174dbb);outline-offset:4px;}.ds-choice span{font-size:15px;line-height:1.6;}.ds-choice.ds-choice-correct{background:var(--green-soft, #e9f5ef);border-color:var(--green, #18715c);}.ds-choice.ds-choice-reconsider{background:var(--amber-soft, #fff4e3);border-color:var(--amber, #875619);}@media(prefers-reduced-motion:reduce){.ds-choice{transition:none;}}"
    },
    {
      "name": "Lesson stages",
      "kind": "nav",
      "refersTo": "lesson-stage",
      "description": "Four current-position controls; these are not completion scores.",
      "html": "<nav class=\"ds-stages\" aria-label=\"Lesson stages\"><button aria-current=\"step\"><span>1</span>See an example</button><button><span>2</span>Try it</button><button><span>3</span>Fresh case</button><button><span>4</span>Your work</button></nav>",
      "css": ".ds-stages{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:5px;}.ds-stages button{display:flex;align-items:center;justify-content:center;flex-direction:column;gap:7px;min-height:66px;border:0;border-radius:9px;padding:10px 5px;background:var(--surface-subtle, #edf2f8);font-family:Inter,sans-serif;font-size:12px;line-height:1.4;color:var(--muted, #51647c);cursor:pointer;}.ds-stages button:hover{background:var(--blue-soft, #eaf0ff);color:var(--blue, #2459d6);}.ds-stages button[aria-current=\"step\"]{color:var(--blue, #2459d6);background:var(--blue-soft, #eaf0ff);box-shadow:inset 0 -2px var(--blue, #2459d6);font-weight:700;}.ds-stages span{width:21px;height:21px;border-radius:50%;display:grid;place-items:center;font-size:12px;border:1px solid var(--line-strong, #afbed1);}.ds-stages button[aria-current=\"step\"] span{color:var(--surface, #ffffff);background:var(--blue, #2459d6);border-color:var(--blue, #2459d6);}.ds-stages button:focus-visible{outline:3px solid var(--focus, #174dbb);outline-offset:4px;}"
    }
  ],
  "narrative": {
    "northStar": "The Working Notebook",
    "overview": "The Working Notebook is calm, explicit and practical. Cool paper surrounds white working surfaces; deep navy gives the current lesson a clear entry point. Blue connects actions and current position, while source context and checked responses have their own restrained colors. The reader uses familiar controls, named navigation and compact stroke icons so its authored examples and the learner’s writing carry the experience.\n\nThis is a code-derived record of assets/docs/learning-design/reader, captured on 28 October 2026. It covers this local reader only. It does not establish a visual migration of the hosted application or a production release. PRODUCT.md records product constraints; .impeccable/surfaces/assets-docs-learning-design-reader.md owns the surface direction. The tokens below describe the implemented CSS, with literal reused values extracted where no CSS custom property exists.",
    "keyCharacteristics": [
      "A single self-hosted sans family with a compact, deliberate hierarchy.",
      "Flat surfaces distinguished by tone, fine borders and open spacing.",
      "Named learning, practice and private-work destinations with visible current state.",
      "Explicit saving and evidence-based status labels beside the work they describe."
    ],
    "rules": [
      {
        "name": "Semantic Color",
        "body": "Use blue for action and current position, teal for source context, green for a checked match, and amber for reconsideration. Pair these colors with explanatory text; color alone does not carry the result.",
        "section": "colors"
      },
      {
        "name": "Readable Work",
        "body": "Keep writing fields at the implemented body size on small screens, preserve visible field labels, and keep paragraphs narrow enough to scan alongside their source.",
        "section": "typography"
      },
      {
        "name": "Flat Surface",
        "body": "Use tonal fills and fine borders to separate regions. The active stage’s inset underline is a state indicator, not elevation.",
        "section": "elevation"
      },
      {
        "name": "Explicit Notebook",
        "body": "Keep the save action and browser-only storage explanation together. A navigation change or typed draft must not be styled as proof of a successful save.",
        "section": "components"
      }
    ],
    "dos": [
      "Do keep source context visually distinct and reachable from the exercise.",
      "Do preserve named controls, visible keyboard focus, and text descriptions of current state.",
      "Do keep the primary lesson save action reachable while the learner writes.",
      "Do describe progress using checked practices, written lessons, recorded self-checks, and the current step.",
      "Do retain separate route drafts and the distinction between a first draft and its revision."
    ],
    "donts": [
      "Don’t style self-checks or activity counts as mastery, grades, credentials, or independent review.",
      "Don’t imply automatic saving, account synchronization, public sharing, or a contacted reviewer.",
      "Don’t promote these local reader tokens into a claim that the hosted application has been restyled."
    ]
  }
}
